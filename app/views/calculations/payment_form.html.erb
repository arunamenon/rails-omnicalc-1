<form action="/payment/results" method="get">
  <label for="user_apr">APR</label>
  <input type="text" id="user_apr" name="user_apr" placeholder = "E.g. 5.42"><br>

  <label for="user_years">Number of years</label>
  <input type="text" id="user_years" name="user_years" placeholder = "How many years to repay?"><br>

  <label for="user_pv">Principal</label>
  <input type="text" id="user_pv" name="user_pv" placeholder = "How much principal?"><br>

  <button type="submit">Calculate monthly payment</button>
</form>
